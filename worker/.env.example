# Copy to worker/.env and adjust (worker/.env is git-ignored). Variables already in the environment win.

# Must match the web-app's REDIS_URL and STREAM_PREFIX, or neither side sees the other's messages.
# On a shared cluster node give Redis a password (requirepass) and put it here.
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
STREAM_PREFIX=video

# Shared with the web-app (SWAP_CASES_DIR / SWAP_CHARS_DIR there): absolute paths both processes can read and write.
# Empty = cases/ and characters/ of this repo (the Gradio UI's folders).
SWAP_CASES_DIR=
SWAP_CHARS_DIR=

# Util role: GPU of the edit planner (Qwen3-VL) and insightface, nvidia-smi numbering. The render role uses the
# ComfyUI servers of scripts/start_comfy.sh (ports 8188-8190) instead.
PLANNER_GPU=0

# Optional
# WORKER_NAME=swap-render-1
# WORKER_CLAIM_IDLE_MS=14400000      # render default 4 h, util default 120000
# SWAP_RUN_CMD=bash scripts/run_swap.sh
