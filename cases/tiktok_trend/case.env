# Case 2: TikTok trend clip (948x576, 30 fps, 25.6 s, 15 shots) - one woman in a red kimono, no other people.
# Paths are relative to this folder. Use ${VAR:-default} so command-line values win.
VIDEO=${VIDEO:-input/tiktok_trend.mp4}
CUTS=${CUTS:-35,74,125,169,206,261,287,418,461,480,521,561,703,727}   # PySceneDetect, last cut corrected 728 -> 727
# new character: face.jpg (selfie) -> face_cutout.png (SAM 3.1 "woman" cut-out on white). Face-only reference:
# KEEP_OUTFIT=1 swaps face, head and hair and keeps the red kimono of the video (consistent with every shot).
CHAR_REF=${CHAR_REF:-input/face_cutout.png}
CHAR_DETAILS=${CHAR_DETAILS:-"Female, slim build, oval face, fair rosy skin, dark brown eyes, small nose, soft pink lips, light brown hair with wispy see-through bangs and face-framing strands, wearing the red floral kimono with the white collar and yellow obi from the guide video"}
KEEP_OUTFIT=${KEEP_OUTFIT:-1}
TARGET_FACE=${TARGET_FACE:-input/target_face.jpg}   # the woman, cropped from frame 405
TARGET_TEXT=${TARGET_TEXT:-"the woman with long black hair in the red kimono"}
PROTECT=${PROTECT-}                     # nobody else to keep
PRESENCE=${PRESENCE:-person}            # single person: generate every shot where she is visible at all
