# Case 1: K-drama hug scene - replace the actress with the character "phuc", keep the man.
# Paths are relative to this folder. Use ${VAR:-default} so command-line values win.
VIDEO=${VIDEO:-input/hug_scene.mp4}
CUTS=${CUTS:-33,92,138,187,256}          # verified manual cuts (auto puts the 4/5 cut at 180)
CHAR_REF=${CHAR_REF:-input/phuc_cutout.png}
CHAR_DETAILS=${CHAR_DETAILS:-"Female, slim build, narrow shoulders, slender waist, oval face, fair pale skin, dark brown eyes, small nose, soft pink lips, long straight wine-red hair with blunt bangs, small stud earrings, black long-sleeve off-the-shoulder crop top, cream pleated midi skirt"}
TARGET_FACE=${TARGET_FACE:-input/target_face.jpg}
TARGET_TEXT=${TARGET_TEXT:-"the woman with long black hair in the white jacket"}
PROTECT=${PROTECT-man}
PROTECT_TEXT=${PROTECT_TEXT:-"the man in the black vest and white shirt"}
SOLO_SHOTS=${SOLO_SHOTS:-4,6}
