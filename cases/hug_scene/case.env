# Case 1: K-drama hug scene - replace the actress with the character "phuc", keep the man.
# Paths are relative to this folder. Use ${VAR:-default} so command-line values win.
VIDEO=${VIDEO:-input/hug_scene.mp4}
CUTS=${CUTS:-33,92,138,187,256}          # verified manual cuts (auto puts the 4/5 cut at 180)
# character sheet (utils/make_char_sheet.py from phuc_cutout.png + phuc_face.jpg, her own outfit): front, side, back
# with the arms down - fixes the raised-arm pose of the photo leaking into shot 2. Single-photo variant:
# CHAR_REF=input/phuc_cutout.png CHAR_REF_EXTRA=""
# standard pipeline: the character sheet is built from these (input/sheet_phuc_own/); CHAR_REF* below is the old
# hand-made 3-view sheet, used only without SHEET_PERSON
SHEET_PERSON=${SHEET_PERSON-input/phuc_cutout.png}
SHEET_FACE=${SHEET_FACE-input/phuc_face.jpg}
CHAR_REF=${CHAR_REF:-input/sheet/view_front.png}
CHAR_REF_EXTRA=${CHAR_REF_EXTRA-input/sheet/view_left.png input/sheet/view_back.png}
CHAR_DETAILS=${CHAR_DETAILS:-"Female, slim build, narrow shoulders, slender waist, oval face, fair pale skin, dark brown eyes, small nose, soft pink lips, long straight wine-red hair with blunt bangs, small stud earrings, black long-sleeve off-the-shoulder crop top, long cream pleated wide-leg trousers, black flat shoes"}
JOB=${JOB:-gen_720_phuc}; OUT=${OUT:-final_720_phuc}
TARGET_FACE=${TARGET_FACE:-input/target_face.jpg}
TARGET_TEXT=${TARGET_TEXT:-"the woman with long black hair in the white jacket"}
PROTECT=${PROTECT-man}
PROTECT_TEXT=${PROTECT_TEXT:-"the man in the black vest and white shirt"}
SOLO_SHOTS=${SOLO_SHOTS:-4,6}
# results: output/final_sheet_seed42/swapped.mp4 (character sheet, best); output/swapped_seed42.mp4, swapped_seed7.mp4 (single photo)
